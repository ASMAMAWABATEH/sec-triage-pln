!(import! &self (library lib_import))
!(git-import! "https://github.com/trueagi-io/PLN.git")
!(import! &self (library PLN lib_pln))
!(import! &self ../kb/security_kb)
!(import! &self ../kb/scenario_facts)
!(import! &self ../src/backward)
!(import! &self ../src/engine)
; S5 multi-step chain: only facts 4-7 of the KB (same IDs and values) so no other path competes.
(= (kbChain)
   ((Sentence ((Inheritance PhishingCompromise MalwareExec)      (stv 0.5 0.9)) (4))
    (Sentence ((Inheritance MalwareExec        CredentialTheft)  (stv 0.4 0.8)) (5))
    (Sentence ((Inheritance CredentialTheft    LateralMovement)  (stv 0.5 0.8)) (6))
    (Sentence ((Inheritance LateralMovement    DataExfiltration) (stv 0.3 0.7)) (7))))
!(Compare (kbChain) PhishingCompromise MalwareExec 0)
!(Compare (kbChain) PhishingCompromise CredentialTheft 1)
!(Compare (kbChain) PhishingCompromise LateralMovement 2)
!(Compare (kbChain) PhishingCompromise DataExfiltration 3)
